# ==============================================================================
# LocalPulse AI - Backend Configuration (.env)
# ==============================================================================

# MongoDB connection (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=localpulse

# JWT Secret for token signing (Set a long random string in production)
JWT_SECRET=localpulse-super-secret-jwt-key-2026-paytm-ai-hackathon

# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. https://your-frontend.vercel.app)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM API Key — Gemini is the default provider
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
LLM_API_KEY=
# Provider: gemini | openai | groq | custom
LLM_PROVIDER=gemini
# Gemini models: gemini-2.5-flash | gemini-1.5-flash | gemini-1.5-pro
LLM_MODEL=gemini-2.5-flash
# Leave blank for Gemini (SDK used directly). Set for OpenAI/Groq/custom base URLs.
LLM_BASE_URL=

# Sarvam AI API Key for Multilingual Speech-to-Text (Hindi, Tamil, Telugu, Kannada, Bengali, etc.)
# Get your Sarvam AI API key from: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

# Calendarific API Key for Real All-India Occasions & Festivals
# 100% Free Forever (500 requests/month, 0 credit card needed): https://calendarific.com/signup
CALENDARIFIC_API_KEY=
